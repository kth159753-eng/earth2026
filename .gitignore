# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/public/exams/**/*.pdf

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files and credentials — never commit
.env
.env.*
!.env.example
!.env.example.*
*.pem
*.p12
*.key
credentials.json
secrets/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
